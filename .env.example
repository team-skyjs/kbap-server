# ─────────────────────────────────────────────────────────────────
# 환경변수 템플릿 — 이 파일(.env.example)은 커밋한다.
# 사용법:  cp .env.example .env   후 .env 에 실제 값을 채운다(.env 는 커밋 금지).
#
# ⚠️ Spring Boot 는 .env 를 "자동으로" 읽지 않는다.
#    - dev/staging/prod: 배포 환경이 주입하는 OS 환경변수로 ${DB_URL} 등이 채워진다.
#    - local: 프로필이 localhost 기본값을 가지므로 .env 없이도 뜬다.
#    - .env 값을 Spring 이 읽게 하려면 spring-dotenv 의존성/IDE EnvFile/쉘 export 중 하나가 필요.
# ─────────────────────────────────────────────────────────────────

# ── Datasource (MySQL) ──
DB_URL=jdbc:mysql://localhost:3306/kbap
DB_USERNAME=kbap
DB_PASSWORD=changeme


# ── Redis (KB-118: refresh token 저장소. TTL 로 만료가 자동 처리된다) ──
# local 프로필은 localhost:6379 기본값을 쓰므로 비워도 뜬다. dev/staging/prod 는 필수.
REDIS_HOST=localhost
REDIS_PORT=6379

# ── 인증 (KB-118) ──
# 자체 JWT(access·refresh) HS256 서명 키. 32바이트 이상이어야 하며, 없거나 짧으면 부팅에 실패한다
# (약한 키로 조용히 뜨는 것을 막는다). 예: openssl rand -base64 32
JWT_SECRET=
# Firebase 서비스 계정 키(콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키).
# 아래 둘 중 하나만 채우면 되고, 내용(JSON)을 넣는 쪽을 권장한다 — 파일 위치가 개발자마다 다를 일이 없고
# 컨테이너·CI 에도 볼륨 마운트 없이 그대로 주입된다. 인코딩:
#   base64 -i firebase-service-account.json | tr -d '\n'
# 둘 다 비우면 부팅은 정상이고 POST /api/v1/auth/login 만 401 을 돌려준다. 키는 커밋 금지.
FIREBASE_CREDENTIALS_JSON=
# 파일 마운트를 쓰는 배포 환경용 대안(절대 경로). JSON 이 설정되어 있으면 무시된다.
FIREBASE_CREDENTIALS_PATH=

# ── 식당 검색 (KB-274) ──
# 카카오 개발자 콘솔 → 내 애플리케이션 → 앱 키 → REST API 키. 서버가 장소 검색을 대신 호출하므로 앱에는 넣지 않는다.
# 비우면 부팅은 정상이고 GET /api/places 만 502(PLACE-001) 를 돌려준다. 키는 커밋 금지.
KAKAO_REST_API_KEY=

# ── LLM API key (전 모델 OpenAI 단일 벤더 — KB-320) ──
# 메뉴판 스캔 vision·음식 이미지 배치 생성(api)과 콘텐츠 생성(batch)이 이 키 하나를 공유한다.
# 스캔은 필수 기능이라 api 는 이 키가 없으면 부팅하지 않는다.
# vision 이 사진을 fetch 할 도메인은 IMAGE_PUBLIC_BASE_URL 을 그대로 쓴다(전용 변수 없음).
OPENAI_API_KEY=

# ── 이미지 스토리지 S3 (KB-145) ──
# presigned 업로드 발급과 vision 이 공유하는 공개(CDN) 베이스. dev/staging/prod 프로필은 기본값이 없어
# 비우면 부팅하지 않는다. local 은 비워도 된다.
IMAGE_PUBLIC_BASE_URL=
STORAGE_BUCKET=
# 공유 버킷의 환경별 폴더 접두(local/dev/staging/prod). 미설정 시 프로필 기본값.
STORAGE_KEY_PREFIX=

# ── 벡터 검색·동기화 (KB-318/319 검색, KB-328 적재) ──
# DocumentDB 연결 — 로컬은 클러스터가 없어 전부 비워 둔다(기본 off, 스캔 유사 매칭·벡터 동기화만 조용히 생략).
# dev 이상에서 켠다: api(스캔 검색)와 batch(foodVectorSyncJob 적재) 둘 다 같은 값을 쓴다.
VECTOR_ENABLED=
VECTOR_DB_URI=
# 기본값 kbap / foods — 클러스터 구성이 다를 때만 지정.
VECTOR_DB_DATABASE=
VECTOR_DB_COLLECTION=
# 임베딩(OpenAI text-embedding-3-small, 256차원) — 켜면 OPENAI_API_KEY 도 필요하다(위 항목 재사용).
EMBEDDING_ENABLED=
