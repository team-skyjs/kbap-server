// 배치 잡 원격 실행 파이프라인 — Pipeline 잡의 스크립트에 그대로 붙여 넣는다.
// 크리덴셜: Username with password 타입, ID = aws-dev / aws-prod (username = Access key ID, password = Secret access key)
pipeline {
  agent any
  parameters {
    choice(name: 'ENV', choices: ['dev', 'prod'], description: '대상 환경')
    choice(name: 'JOB', choices: ['foodContentOutboxPublishJob', 'foodVectorSyncJob'], description: '실행할 배치 잡')
    booleanParam(name: 'WAIT', defaultValue: true, description: '완료(COMPLETED/FAILED)까지 30초 간격 폴링')
  }
  stages {
    stage('checkout') {
      steps { git url: 'https://github.com/team-skyjs/kbap-server.git', branch: 'develop', credentialsId: 'github' }
    }
    stage('run') {
      steps {
        withCredentials([usernamePassword(credentialsId: "aws-${params.ENV}",
                                          usernameVariable: 'AWS_ACCESS_KEY_ID',
                                          passwordVariable: 'AWS_SECRET_ACCESS_KEY')]) {
          script {
            def out = sh(script: "iac/scripts/batch-job.sh run ${params.ENV} ${params.JOB}", returnStdout: true).trim()
            echo out
            def id = (out =~ /"executionId":(\d+)/)[0][1]
            if (params.WAIT) {
              timeout(time: 60, unit: 'MINUTES') {
                waitUntil {
                  sleep 30
                  def s = sh(script: "iac/scripts/batch-job.sh status ${params.ENV} ${id}", returnStdout: true).trim()
                  echo s
                  if (s.contains('"FAILED"')) { error "batch job ${params.JOB} failed (executionId=${id})" }
                  return s.contains('"COMPLETED"')
                }
              }
            }
          }
        }
      }
    }
  }
}
