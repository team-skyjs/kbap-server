env       = "dev"
vpc_name  = "kbap-devstg-vpc"
subdomain = "dev-ecs"

spring_profile     = "dev"
storage_key_prefix = "dev"

api_image   = "118178010621.dkr.ecr.ap-northeast-2.amazonaws.com/kbap/api:<git-sha>"
batch_image = "118178010621.dkr.ecr.ap-northeast-2.amazonaws.com/kbap/batch:<git-sha>"

db_url                  = "jdbc:mysql://kbap-db-devstg.cfy0goiqwlg7.ap-northeast-2.rds.amazonaws.com:3306/kbap-dev"
redis_host              = "kbap-devstg-redis-0001-001.kbap-devstg-redis.fu1mox.apn2.cache.amazonaws.com"
rds_security_group_id   = "sg-00be0b3653aa0b87f"
redis_security_group_id = "sg-0de1e4bfcad5ec753"

# 기본값: api 풀 t4g.medium × 2(인스턴스당 태스크 1, 메모리 3000), batch 풀 t4g.small(메모리 1200), 로그 7일. 배포는 ECS 롤링(min 50%/max 100%).
# 2026-10-28 비용 축소로 api 1대였던 것을 t4g 전환(2026-11)과 함께 2대로 되돌린다 — Spot t4g.medium 2대가 t3.medium 1대보다 싸다.
# dev 는 Spot — 회수(월 0~몇 번) 땐 2분 전 드레인 후 ASG 가 새로 띄운다. prod 는 온디맨드
spot_instances = true
# batch 는 prod 만 운영 — dev 0(음식 콘텐츠 적재는 prod 배치가 담당)
batch_instance_count = 0
batch_desired_count  = 0

api_execute_command_enabled          = true
performance_artifact_retention_days = 7

admin_cidr       = "<your-public-ip>/32"
bastion_key_name = "kbpa-devstg"

# 관측(KB-381): 각 EC2 의 Alloy DAEMON 이 앱·호스트 메트릭을 홈서버 Prometheus 로 push 한다.
# 토큰은 SSM /kbap/<env>/CF_ACCESS_CLIENT_ID · CF_ACCESS_CLIENT_SECRET (SecureString) 에 미리 등록.

# 공개 진입점 차단(KB-390): /actuator 류만. dev 는 Swagger 를 공개한다.
blocked_path_patterns = ["*actuator*"]

# S3 Vectors 벡터 검색(api)·적재(batch foodVectorSyncJob) 앱 스위치 — 버킷·인덱스·IAM 은 항상 생성, env 주입만 토글.
# 적용은 README "벡터 검색·적재 켜기" 절.
vector_enabled = true

# Langfuse(관리자 페이지 LLM 지표 프록시용). 키는 SSM /kbap/<env>/LANGFUSE_PUBLIC_KEY · LANGFUSE_SECRET_KEY (SecureString), host 만 평문.
# 앱 토글은 전부 여기 — 리비전에 손으로 넣으면 Terraform 이 태스크 정의를 다시 만들 때(-replace·runtime_platform 변경 등) 사라진다
api_extra_env = {
  LANGFUSE_HOST                 = "https://cloud.langfuse.com"
  REVIEW_BOT_ENABLED            = "true"
  REVIEW_BOT_PHOTO_SYNC_ENABLED = "true"
}
batch_extra_env = {
  PROCESSED_FOOD_MIRROR_ENABLED = "true"
  REVIEW_BOT_PHOTO_SYNC_ENABLED = "true"
}
# batch 는 모듈 기본 목록 + dev 전용 시크릿(SSM /kbap/dev/<NAME> 에 값이 있어야 태스크가 뜬다). api 는 기본 목록 그대로
batch_secret_names = ["DB_PASSWORD", "OPENAI_API_KEY", "BATCH_SENTRY_DSN", "SLACK_STATS_WEBHOOK_URL", "DATA_GO_KR_SERVICE_KEY"]
