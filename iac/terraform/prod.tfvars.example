env       = "prod"
vpc_name  = "kbap-prod-vpc"
subdomain = "prod-ecs"

spring_profile     = "prod"
storage_key_prefix = "prod"

# 콘텐츠 생성 요청 큐는 환경별(KB-547) — 생략하면 기본값(dev 공유 큐 kbap-generate-content-queue)으로 떨어져 prod 요청이 dev 로 샌다
food_content_queue_name = "kbap-prod-generate-content-queue"

# 비용 축소(2026-10-28): api 인스턴스·태스크 1 — 카나리 중에만 인스턴스당 2 태스크(512 cpu / 1536 MiB 유지 전제)
api_instance_count = 1
api_desired_count  = 1

# 2026-08-31 배치 가동 결정 — 구 kbap-prod-cluster 는 INACTIVE 라 이중 운영 사유 소멸. dev 배치는 0 이라 prod 배치가 유일
batch_instance_count = 1
batch_desired_count  = 1

api_image   = "118178010621.dkr.ecr.ap-northeast-2.amazonaws.com/kbap/api:<release-tag>"
batch_image = "118178010621.dkr.ecr.ap-northeast-2.amazonaws.com/kbap/batch:<release-tag>"

# 스키마는 기존 운영(/kbap)과 분리한 새 스키마 /kbap-prod — 운영 DB 를 건드리지 않기 위함. apply 전 RDS 에 kbap-prod 스키마를 만들어 둘 것
db_url                  = "jdbc:mysql://kbap-db-prod.cfy0goiqwlg7.ap-northeast-2.rds.amazonaws.com:3306/kbap-prod"
redis_host              = "kbap-prod-redis-0001-001.kbap-prod-redis.fu1mox.apn2.cache.amazonaws.com"
rds_security_group_id   = "sg-0ae5dcd7bd3580cb3"
redis_security_group_id = "sg-0fd902271294eb663"

api_execute_command_enabled          = false
performance_artifact_retention_days = 7

admin_cidr       = "<your-public-ip>/32"
bastion_key_name = "kbap-prod"

# 관측(KB-381): 각 EC2 의 Alloy DAEMON 이 앱·호스트 메트릭을 홈서버 Prometheus 로 push 한다.
# 토큰은 SSM /kbap/<env>/CF_ACCESS_CLIENT_ID · CF_ACCESS_CLIENT_SECRET (SecureString) 에 미리 등록.

# 공개 진입점 차단(KB-390): prod 는 Swagger·OpenAPI 문서도 막는다.
blocked_path_patterns = ["*actuator*", "*swagger*", "*api-docs*"]

# Langfuse(관리자 페이지 LLM 지표 프록시용). 키는 SSM /kbap/<env>/LANGFUSE_PUBLIC_KEY · LANGFUSE_SECRET_KEY (SecureString), host 만 평문.
# ADS_REWARD_UNIT_IDS(KB-740): 보상형 광고 적립 API 가 받는 AdMob 보상형 단위 허용 목록(쉼표 구분, 비밀 아님 — 앱 바이너리에 들어가는 값).
#   prod 실단위 scan_unlock_rewarded Android·iOS(spec admob-ids-2026-10-12.md). dev 는 넣지 않는다(yml 기본 = Google 데모 단위).
#   2026-10-13 예진이 live taskdef 에 수동 등록한 값을 IaC 에 기록한다. api 태스크 정의는 ignore_changes = [container_definitions] 라
#   일반 apply 로는 반영도 되돌림도 없다 — IaC 리비전에 넣으려면 apply -replace=module.ecs_environment.aws_ecs_task_definition.api(README 절차).
#   그 전까지 live 값은 deploy-prod 가 직전 리비전을 복제해 유지한다(2026-10-27 기준 kbap-prod-ecs-api:13).
api_extra_env = {
  LANGFUSE_HOST       = "https://cloud.langfuse.com"
  ADS_REWARD_UNIT_IDS = "ca-app-pub-7408893286425419/4681648821,ca-app-pub-7408893286425419/9167688747"
}
